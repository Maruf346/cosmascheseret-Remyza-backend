# ============================================================
# REMYZA / CHESERA - PRODUCTION ENVIRONMENT VARIABLES
# ============================================================

# ------- Django Core ----------------------------------------
SECRET_KEY=your-very-long-random-secret-key-min-50-chars
DEBUG=False
SERVE_MEDIA=False
ENABLE_BROWSABLE_API=False

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=api.trychesera.com,trychesera.com,www.trychesera.com,100.60.254.161

# Comma-separated list of trusted CSRF origins (full URLs)
CSRF_TRUSTED_ORIGINS=https://api.trychesera.com,https://trychesera.com,https://www.trychesera.com

# ------- Database (AWS RDS PostgreSQL) ----------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=remyza_db
DB_USER=remyza_user
DB_PASSWORD=your-strong-db-password
DB_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
DB_PORT=5432

# ------- AWS S3 (Media Files) --------------------------------
USE_S3=True
AWS_ACCESS_KEY_ID=secret-access-key-for-aws
AWS_SECRET_ACCESS_KEY=secret-secret-key-for-aws
AWS_STORAGE_BUCKET_NAME=remyza-media-prod
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=remyza-media-prod.s3.amazonaws.com

# ------- Email (SMTP / SES) ----------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-ses-smtp-username
EMAIL_HOST_PASSWORD=your-ses-smtp-password
DEFAULT_FROM_EMAIL=no-reply@remyza.com

# ------- Frontend App ----------------------------------------
FRONTEND_APP_KEY=your-frontend-app-key
FRONTEND_URL=https://trychesera.com

# ------- Google Maps ----------------------------------------
GOOGLE_MAP_API_KEY=your-google-map-api-key

# ------- Twilio Credentials ----------------------------------
ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH_TOKEN=your-auth-token

WEBHOOK_URL=https://api.trychesera.com/api/v1/twilio/webhook/

FREE_TRAIL_OWNER_ACCOUNT_ID=your-free-trail-owner-account-id
FREE_TRAIL_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FREE_TRAIL_AUTH_TOKEN=your-free-trail-auth-token

OWNER_ACCOUNT_ID_2=your-owner-account-id-2
SID_2=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH_TOKEN_2=your-auth-token-2

trust_hub_policy_sid=your-trust-hub-policy-sid
a2p_evaluation_policy_sid=your-a2p-evaluation-policy-sid
STARTER_CUSTOMER_PROFILE_POLICY_SID=your-starter-customer-profile-policy-sid
SECONDARY_CUSTOMER_PROFILE_POLICY_SID=your-secondary-customer-profile-policy-sid

# ------- OpenAI ---------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------- Sent.dm Credentials --------------------------------
SENTDM_API_BASE=https://api.sent.dm/v3
SENTDM_API_KEY=your-sentdm-api-key
SENTDM_ORGANIZATION_ID=your-sentdm-organization-id
SENTDM_SANDBOX_MODE=False
SENTDM_WEBHOOK_SECRET=your-sentdm-webhook-secret
SENTDM_WEBHOOK_TOLERANCE_SECONDS=300

# ------- Celery / Redis -------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False
SENTDM_WEBHOOK_ASYNC_ENABLED=True
